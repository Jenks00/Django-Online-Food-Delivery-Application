# Copy this file to .env and adjust the values for your environment.
# None of these are required for local development -- sensible defaults
# are used automatically if a variable is not set.

# A long, random, secret string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-in-production

# Never leave this on in production.
DEBUG=True

# Comma-separated list of hostnames this site is allowed to serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# Google sign-in (OAuth 2.0 client) -- console.cloud.google.com > APIs &
# Services > Credentials. The "Continue with Google" button renders either
# way, but clicking it errors until these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple sign-in -- developer.apple.com > Certificates, Identifiers &
# Profiles > Keys (Sign in with Apple).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
